# ============================================
# The Golden Fork - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# ALL services have graceful fallbacks — the app
# works in "demo mode" without any keys configured.
# ============================================

# --- OpenAI (for AI chatbot) ---
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# --- Pinecone (for menu vector search / RAG) ---
# Get your key: https://app.pinecone.io
# Create index: dimension 1536, metric cosine
PINECONE_API_KEY=
PINECONE_INDEX_NAME=restaurant-menu

# --- Stripe (for payments) ---
# Get your keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WebSocket (for real-time kitchen updates) ---
WS_PORT=3002
# For local dev:
NEXT_PUBLIC_WS_URL=ws://localhost:3002
WS_INTERNAL_URL=ws://localhost:3002
# For production, use wss:// with your domain:
# NEXT_PUBLIC_WS_URL=wss://your-app.railway.app
# WS_INTERNAL_URL=ws://localhost:3002

# --- Rate Limiting (for AI chatbot) ---
# Protects your OpenAI API costs from abuse
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_MS=3600000

# --- Application ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
RESTAURANT_NAME=The Golden Fork
NODE_ENV=development
